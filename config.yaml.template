server:
  sources:
    - path: "/files"
      name: "Files"
      config:
        defaultEnabled: true
        createUserDir: false

http:
  port: 80
  baseURL: "/"
  externalUrl: "https://files.${DOMAIN}"
  trustProxyHeaders: true # behind Traefik: use X-Forwarded-For for client IPs

auth:
  adminUsername: admin
  methods:
    password:
      enabled: true
      minLength: 8
      signup: false
